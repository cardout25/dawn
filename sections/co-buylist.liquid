{%- comment -%} Card Out — Buylist: sellers build a list of cards and request a quote {%- endcomment -%}
{{ 'https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;700&family=Inter:wght@400;500;600;700&display=swap' | stylesheet_tag }}

{%- liquid
  assign handles = ''
  for block in section.blocks
    if block.settings.collection != blank
      assign handles = handles | append: block.settings.collection.handle | append: '|' | append: block.settings.label | append: ','
    endif
  endfor
-%}

<style>
  #co-buy-{{ section.id }} { --ink: #1A1A1A; --muted: #6B655C; --line: #ECE8E1; --soft: #FAF8F4; --coral: #F25C54; --coral-dark: #B3352E; --gold: #F5C12E;
    background: #FFFFFF; color: var(--ink); font-family: 'Inter', var(--font-body-family); padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px; }
  #co-buy-{{ section.id }} h1, #co-buy-{{ section.id }} h2, #co-buy-{{ section.id }} h3 { font-family: 'Space Grotesk', var(--font-heading-family); color: var(--ink); letter-spacing: -.01em; }
  #co-buy-{{ section.id }} .cb-hero { background: var(--gold); border-radius: 2.4rem; padding: 4.8rem 4rem; margin-bottom: 3.2rem; }
  #co-buy-{{ section.id }} .cb-kicker { margin: 0 0 1rem; font-size: 1.3rem; font-weight: 700; letter-spacing: .16em; text-transform: uppercase; color: #5A4708; }
  #co-buy-{{ section.id }} .cb-hero h1 { margin: 0 0 1.2rem; font-size: clamp(3.4rem, 4.6vw, 5.2rem); line-height: 1.05; }
  #co-buy-{{ section.id }} .cb-hero p { margin: 0; max-width: 64rem; font-size: 1.7rem; line-height: 1.6; color: #3B3214; }
  #co-buy-{{ section.id }} .cb-steps { list-style: none; margin: 2.8rem 0 0; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1.4rem; counter-reset: step; }
  #co-buy-{{ section.id }} .cb-steps li { background: rgba(255,255,255,.75); border-radius: 1.6rem; padding: 1.8rem; font-size: 1.4rem; line-height: 1.5; color: #3B3214; counter-increment: step; }
  #co-buy-{{ section.id }} .cb-steps li::before { content: counter(step); display: inline-grid; place-items: center; width: 2.8rem; height: 2.8rem; border-radius: 50%; background: var(--ink); color: #FFFFFF; font-weight: 700; font-size: 1.3rem; margin-bottom: .8rem; }
  #co-buy-{{ section.id }} .cb-steps strong { display: block; font-size: 1.6rem; color: var(--ink); margin-bottom: .2rem; }

  #co-buy-{{ section.id }} .cb-layout { display: grid; grid-template-columns: minmax(0, 1fr) 38rem; gap: 3.2rem; align-items: start; }
  #co-buy-{{ section.id }} .cb-tools { display: flex; flex-wrap: wrap; gap: 1rem; align-items: center; margin-bottom: 1.6rem; }
  #co-buy-{{ section.id }} .cb-search { position: relative; flex: 1 1 26rem; }
  #co-buy-{{ section.id }} .cb-search svg { position: absolute; left: 1.6rem; top: 50%; transform: translateY(-50%); width: 1.8rem; height: 1.8rem; color: var(--muted); }
  #co-buy-{{ section.id }} .cb-search input { width: 100%; height: 4.6rem; box-sizing: border-box; padding: 0 1.6rem 0 4.4rem; border: 1.5px solid #DDD8CF; border-radius: 999px; font: inherit; font-size: 1.5rem; background: #FFFFFF; color: var(--ink); }
  #co-buy-{{ section.id }} .cb-search input:focus, #co-buy-{{ section.id }} select:focus, #co-buy-{{ section.id }} .cb-field input:focus, #co-buy-{{ section.id }} .cb-field textarea:focus { outline: none; border-color: var(--ink); box-shadow: 0 0 0 4px rgba(245,193,46,.45); }
  #co-buy-{{ section.id }} .cb-chip { min-height: 4rem; padding: 0 1.6rem; border-radius: 999px; border: 1px solid #DDD8CF; background: #FFFFFF; color: var(--ink); font: inherit; font-size: 1.4rem; font-weight: 600; cursor: pointer; }
  #co-buy-{{ section.id }} .cb-chip[aria-pressed="true"] { background: var(--ink); color: #FFFFFF; border-color: var(--ink); }
  #co-buy-{{ section.id }} select { height: 4rem; padding: 0 3.2rem 0 1.4rem; border: 1px solid #DDD8CF; border-radius: 999px; background-color: #FFFFFF; font: inherit; font-size: 1.4rem; color: var(--ink); }
  #co-buy-{{ section.id }} .cb-count { font-size: 1.3rem; color: var(--muted); margin: 0 0 1rem; }

  #co-buy-{{ section.id }} .cb-list { list-style: none; margin: 0; padding: 0; border: 1px solid var(--line); border-radius: 1.8rem; overflow: hidden; }
  #co-buy-{{ section.id }} .cb-row { display: grid; grid-template-columns: 5.6rem minmax(0, 1fr) auto; gap: 1.4rem; align-items: center; padding: 1.2rem 1.6rem; border-bottom: 1px solid var(--line); }
  #co-buy-{{ section.id }} .cb-row:last-child { border-bottom: 0; }
  #co-buy-{{ section.id }} .cb-thumb { width: 5.6rem; aspect-ratio: 744 / 1039; border-radius: .6rem; object-fit: cover; background: #F4F1EC; display: block; }
  #co-buy-{{ section.id }} .cb-name { font-weight: 600; font-size: 1.5rem; margin: 0 0 .2rem; }
  #co-buy-{{ section.id }} .cb-meta { font-size: 1.2rem; color: var(--muted); margin: 0 0 .6rem; }
  #co-buy-{{ section.id }} .cb-offer { display: flex; gap: 1.2rem; flex-wrap: wrap; font-size: 1.3rem; }
  #co-buy-{{ section.id }} .cb-offer b { font-size: 1.5rem; }
  #co-buy-{{ section.id }} .cb-cash b { color: var(--ink); }
  #co-buy-{{ section.id }} .cb-credit b { color: var(--coral-dark); }
  #co-buy-{{ section.id }} .cb-actions { display: flex; gap: .8rem; align-items: center; }
  #co-buy-{{ section.id }} .cb-actions select { height: 3.8rem; font-size: 1.3rem; padding: 0 2.6rem 0 1.2rem; }
  #co-buy-{{ section.id }} .cb-add { min-height: 3.8rem; padding: 0 1.6rem; border-radius: 999px; border: 0; background: var(--coral); color: #FFFFFF; font: inherit; font-weight: 600; font-size: 1.4rem; cursor: pointer; white-space: nowrap; }
  #co-buy-{{ section.id }} .cb-add:hover { background: #D9443C; }
  #co-buy-{{ section.id }} .cb-more { display: block; margin: 1.6rem auto 0; min-height: 4.4rem; padding: 0 2.4rem; border-radius: 999px; border: 1px solid var(--ink); background: #FFFFFF; font: inherit; font-weight: 600; font-size: 1.4rem; cursor: pointer; }
  #co-buy-{{ section.id }} .cb-empty { padding: 3.2rem 1.6rem; text-align: center; color: var(--muted); font-size: 1.5rem; margin: 0; }

  #co-buy-{{ section.id }} .cb-cart { position: sticky; top: 2rem; border: 1px solid var(--line); border-radius: 2rem; background: var(--soft); padding: 2.2rem; }
  #co-buy-{{ section.id }} .cb-cart h2 { margin: 0 0 1.4rem; font-size: 2.4rem; display: flex; justify-content: space-between; align-items: baseline; }
  #co-buy-{{ section.id }} .cb-cart h2 span { font-family: 'Inter', sans-serif; font-size: 1.4rem; color: var(--muted); font-weight: 500; }
  #co-buy-{{ section.id }} .cb-lines { list-style: none; margin: 0 0 1.4rem; padding: 0; max-height: 30rem; overflow-y: auto; }
  #co-buy-{{ section.id }} .cb-line { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: .4rem 1rem; padding: 1rem 0; border-bottom: 1px solid var(--line); font-size: 1.35rem; }
  #co-buy-{{ section.id }} .cb-line-name { font-weight: 600; }
  #co-buy-{{ section.id }} .cb-line-sub { color: var(--muted); font-size: 1.25rem; }
  #co-buy-{{ section.id }} .cb-line-ctrl { display: flex; align-items: center; gap: .4rem; }
  #co-buy-{{ section.id }} .cb-qbtn { width: 3.2rem; height: 3.2rem; border-radius: 50%; border: 1px solid #DDD8CF; background: #FFFFFF; font: inherit; font-size: 1.6rem; cursor: pointer; line-height: 1; }
  #co-buy-{{ section.id }} .cb-cart-empty { color: var(--muted); font-size: 1.4rem; margin: 0 0 1.4rem; }
  #co-buy-{{ section.id }} .cb-totals { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; margin-bottom: 1.6rem; }
  #co-buy-{{ section.id }} .cb-total { background: #FFFFFF; border: 1.5px solid var(--line); border-radius: 1.4rem; padding: 1.2rem 1.4rem; cursor: pointer; display: block; }
  #co-buy-{{ section.id }} .cb-total input { position: absolute; opacity: 0; pointer-events: none; }
  #co-buy-{{ section.id }} .cb-total span { display: block; font-size: 1.2rem; font-weight: 600; color: var(--muted); text-transform: uppercase; letter-spacing: .08em; }
  #co-buy-{{ section.id }} .cb-total b { display: block; font-size: 2rem; margin-top: .2rem; }
  #co-buy-{{ section.id }} .cb-total:has(input:checked) { border-color: var(--ink); box-shadow: 0 0 0 1px var(--ink); }
  #co-buy-{{ section.id }} .cb-total:focus-within { box-shadow: 0 0 0 4px rgba(245,193,46,.45); }
  #co-buy-{{ section.id }} .cb-field { margin-bottom: 1rem; }
  #co-buy-{{ section.id }} .cb-field label { display: block; font-size: 1.3rem; font-weight: 600; margin-bottom: .4rem; }
  #co-buy-{{ section.id }} .cb-field input, #co-buy-{{ section.id }} .cb-field textarea { width: 100%; box-sizing: border-box; min-height: 4.4rem; padding: 1rem 1.4rem; border: 1px solid #DDD8CF; border-radius: 1.2rem; font: inherit; font-size: 1.5rem; background: #FFFFFF; color: var(--ink); }
  #co-buy-{{ section.id }} .cb-field textarea { min-height: 8rem; resize: vertical; }
  #co-buy-{{ section.id }} .cb-submit { width: 100%; min-height: 5rem; border: 0; border-radius: 999px; background: var(--ink); color: #FFFFFF; font: inherit; font-weight: 600; font-size: 1.6rem; cursor: pointer; margin-top: .6rem; }
  #co-buy-{{ section.id }} .cb-submit[disabled] { background: #CFC9BE; cursor: not-allowed; }
  #co-buy-{{ section.id }} .cb-note { font-size: 1.25rem; line-height: 1.5; color: var(--muted); margin: 1.2rem 0 0; }
  #co-buy-{{ section.id }} .cb-alert { border-radius: 1.4rem; padding: 1.6rem; margin-bottom: 1.6rem; font-size: 1.5rem; line-height: 1.5; }
  #co-buy-{{ section.id }} .cb-alert--ok { background: #E7F5EA; color: #1E5631; }
  #co-buy-{{ section.id }} .cb-alert--err { background: #FDECEA; color: #8A2620; }
  #co-buy-{{ section.id }} .cb-mobilebar { display: none; }
  #co-buy-{{ section.id }} .cb-vh { position: absolute !important; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }

  @media screen and (max-width: 989px) {
    #co-buy-{{ section.id }} .cb-layout { grid-template-columns: 1fr; }
    #co-buy-{{ section.id }} .cb-cart { position: static; }
    #co-buy-{{ section.id }} .cb-mobilebar { display: flex; position: fixed; left: 1.2rem; right: 1.2rem; bottom: 1.2rem; z-index: 5; justify-content: space-between; align-items: center; gap: 1rem; padding: 1rem 1rem 1rem 1.8rem; border-radius: 999px; background: var(--ink); color: #FFFFFF; font-size: 1.4rem; box-shadow: 0 10px 30px rgba(0,0,0,.3); }
    #co-buy-{{ section.id }} .cb-mobilebar[hidden] { display: none; }
    #co-buy-{{ section.id }} .cb-mobilebar a { background: var(--coral); color: #FFFFFF; text-decoration: none; font-weight: 600; padding: 1rem 1.6rem; border-radius: 999px; }
  }
  @media screen and (max-width: 749px) {
    #co-buy-{{ section.id }} .cb-hero { padding: 3.2rem 2.2rem; border-radius: 1.8rem; }
    #co-buy-{{ section.id }} .cb-steps { grid-template-columns: 1fr; }
    #co-buy-{{ section.id }} .cb-row { grid-template-columns: 4.8rem minmax(0, 1fr); }
    #co-buy-{{ section.id }} .cb-thumb { width: 4.8rem; }
    #co-buy-{{ section.id }} .cb-actions { grid-column: 1 / -1; justify-content: flex-end; }
  }
</style>

<div id="co-buy-{{ section.id }}">
  <div class="page-width">
    <div class="cb-hero">
      {%- if section.settings.kicker != blank -%}<p class="cb-kicker">{{ section.settings.kicker }}</p>{%- endif -%}
      <h1>{{ section.settings.heading }}</h1>
      {%- if section.settings.intro != blank -%}<p>{{ section.settings.intro }}</p>{%- endif -%}
      <ol class="cb-steps">
        <li><strong>Build your list</strong>Search for your cards, pick the condition and add them.</li>
        <li><strong>Request a quote</strong>Choose cash or store credit and send us your list.</li>
        <li><strong>Drop off and get paid</strong>{{ section.settings.dropoff_text }}</li>
      </ol>
    </div>

    <div class="cb-layout">
      <div>
        <div class="cb-tools">
          <div class="cb-search">
            <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="7"/><path d="M20 20l-3.5-3.5"/></svg>
            <label class="cb-vh" for="cb-q-{{ section.id }}">Search the buylist</label>
            <input id="cb-q-{{ section.id }}" type="search" placeholder="Search card name or set code" autocomplete="off" data-q>
          </div>
          <div data-games style="display:flex; gap:.8rem; flex-wrap:wrap;"></div>
          <label class="cb-vh" for="cb-set-{{ section.id }}">Filter by set</label>
          <select id="cb-set-{{ section.id }}" data-set><option value="">All sets</option></select>
        </div>
        <p class="cb-count" aria-live="polite" data-count>Loading the buylist…</p>
        <ul class="cb-list" data-list></ul>
        <button type="button" class="cb-more" data-more hidden>Show more cards</button>
      </div>

      <aside class="cb-cart" id="cb-cart-{{ section.id }}" aria-labelledby="cb-cart-title-{{ section.id }}">
        {%- form 'contact', id: 'cb-buylist-form' -%}
          {%- if form.posted_successfully? -%}
            <div class="cb-alert cb-alert--ok" role="status" data-posted>Thanks! We've received your sell list and will reply with your quote soon.</div>
          {%- endif -%}
          {%- if form.errors -%}
            <div class="cb-alert cb-alert--err" role="alert">{{ form.errors | default_errors }}</div>
          {%- endif -%}

          <h2 id="cb-cart-title-{{ section.id }}">Your sell list <span data-cart-count>0 cards</span></h2>
          <p class="cb-cart-empty" data-cart-empty>Nothing yet. Add cards from the buylist to see your offer.</p>
          <ul class="cb-lines" data-lines></ul>

          <fieldset style="border:0; margin:0; padding:0;">
            <legend class="cb-vh">Choose your payout</legend>
            <div class="cb-totals">
              <label class="cb-total"><input type="radio" name="contact[Payout]" value="Cash" data-payout><span>Cash</span><b data-total-cash>$0.00</b></label>
              <label class="cb-total"><input type="radio" name="contact[Payout]" value="Store credit" data-payout checked><span>Store credit</span><b data-total-credit>$0.00</b></label>
            </div>
          </fieldset>

          <div class="cb-field"><label for="cb-name-{{ section.id }}">Name</label><input id="cb-name-{{ section.id }}" type="text" name="contact[name]" autocomplete="name" required></div>
          <div class="cb-field"><label for="cb-email-{{ section.id }}">Email</label><input id="cb-email-{{ section.id }}" type="email" name="contact[email]" autocomplete="email" required></div>
          <div class="cb-field"><label for="cb-phone-{{ section.id }}">Phone (optional)</label><input id="cb-phone-{{ section.id }}" type="tel" name="contact[phone]" autocomplete="tel"></div>
          <div class="cb-field"><label for="cb-notes-{{ section.id }}">Notes (optional)</label><textarea id="cb-notes-{{ section.id }}" name="contact[Notes]" placeholder="Anything we should know? e.g. when you plan to drop off"></textarea></div>
          <input type="hidden" name="contact[Request]" value="Buylist quote">
          <input type="hidden" name="contact[Hand-over]" value="Drop off in store">
          <input type="hidden" name="contact[body]" data-body>
          <button type="submit" class="cb-submit" data-submit disabled>Request my quote</button>
          <p class="cb-note">{{ section.settings.terms }}</p>
        {%- endform -%}
      </aside>
    </div>
  </div>

  <div class="cb-mobilebar" data-mobilebar hidden>
    <span data-mobile-summary>0 cards</span>
    <a href="#cb-cart-{{ section.id }}">View sell list</a>
  </div>
</div>

<script>
  (function () {
    var root = document.getElementById('co-buy-{{ section.id }}');
    if (!root) return;
    var CASH = {{ section.settings.cash_pct | default: 50 }} / 100;
    var CREDIT = {{ section.settings.credit_pct | default: 65 }} / 100;
    var MIN = {{ section.settings.min_offer | default: 5 }} / 100;
    var MAXQ = {{ section.settings.max_qty | default: 8 }};
    var CONDS = [
      { k: 'NM', label: 'Near Mint', f: 1 },
      { k: 'LP', label: 'Lightly Played', f: {{ section.settings.lp_pct | default: 85 }} / 100 },
      { k: 'MP', label: 'Moderately Played', f: {{ section.settings.mp_pct | default: 70 }} / 100 },
      { k: 'HP', label: 'Heavily Played', f: {{ section.settings.hp_pct | default: 50 }} / 100 }
    ];
    var SOURCES = {{ handles | json }}.split(',').filter(Boolean).map(function (s) { var p = s.split('|'); return { handle: p[0], label: p[1] || p[0] }; });
    var STORE_KEY = 'co-buylist-v1';
    var PAGE = 30;

    var el = function (sel) { return root.querySelector(sel); };
    var listEl = el('[data-list]'), countEl = el('[data-count]'), moreBtn = el('[data-more]');
    var qEl = el('[data-q]'), setEl = el('[data-set]'), gamesEl = el('[data-games]');
    var linesEl = el('[data-lines]'), emptyEl = el('[data-cart-empty]'), cartCount = el('[data-cart-count]');
    var cashEl = el('[data-total-cash]'), creditEl = el('[data-total-credit]'), bodyEl = el('[data-body]'), submitEl = el('[data-submit]');
    var mobilebar = el('[data-mobilebar]'), mobileSummary = el('[data-mobile-summary]');

    var cards = [], shown = PAGE, game = '', sell = [];
    function esc(s) { return String(s == null ? '' : s).replace(/[&<>"']/g, function (c) { return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]; }); }
    function money(n) { return '$' + n.toFixed(2); }
    function floor5(n) { return Math.floor(n * 20 + 1e-9) / 20; }
    function offer(card, condK, rate) {
      var c = CONDS.filter(function (x) { return x.k === condK; })[0] || CONDS[0];
      return floor5(card.price * rate * c.f);
    }
    function load() { try { var v = JSON.parse(localStorage.getItem(STORE_KEY) || '[]'); return Array.isArray(v) ? v : []; } catch (e) { return []; } }
    function save() { try { localStorage.setItem(STORE_KEY, JSON.stringify(sell)); } catch (e) {} }

    if (el('[data-posted]')) { sell = []; save(); } else { sell = load(); }

    function fetchAll(src) {
      var out = [];
      function page(n) {
        return fetch('/collections/' + encodeURIComponent(src.handle) + '/products.json?limit=250&page=' + n)
          .then(function (r) { return r.ok ? r.json() : { products: [] }; })
          .then(function (d) {
            var ps = (d && d.products) || [];
            ps.forEach(function (p) {
              var v = (p.variants || [])[0] || {};
              var price = parseFloat(v.price);
              if (!isFinite(price)) return;
              var t = String(p.title || '');
              var code = t.indexOf('[') > -1 ? t.split('[').pop().replace(']', '').trim() : '';
              var set = code ? code.split(' ')[0] : '';
              var img = (p.images && p.images[0] && p.images[0].src) || '';
              out.push({ id: String(p.id), title: t, name: t.split(' [')[0], code: code, set: set, game: src.label, price: price, url: '/products/' + p.handle,
                img: img ? img + (img.indexOf('?') > -1 ? '&' : '?') + 'width=140' : '' });
            });
            if (ps.length === 250 && n < 20) return page(n + 1);
            return out;
          });
      }
      return page(1).catch(function () { return out; });
    }

    function filtered() {
      var q = qEl.value.trim().toLowerCase(), s = setEl.value;
      return cards.filter(function (c) {
        if (game && c.game !== game) return false;
        if (s && c.set !== s) return false;
        if (offer(c, 'NM', CASH) < MIN) return false;
        if (!q) return true;
        return (c.name + ' ' + c.code + ' ' + c.game).toLowerCase().indexOf(q) > -1;
      }).sort(function (a, b) { return b.price - a.price; });
    }

    function renderList() {
      var rows = filtered();
      countEl.textContent = rows.length + (rows.length === 1 ? ' card' : ' cards') + ' on the buylist';
      if (!rows.length) { listEl.innerHTML = '<li class="cb-empty">No cards match. Try another search, or ask us about cards not listed.</li>'; moreBtn.hidden = true; return; }
      var html = '';
      rows.slice(0, shown).forEach(function (c) {
        var opts = CONDS.map(function (x) { return '<option value="' + x.k + '">' + x.k + '</option>'; }).join('');
        html += '<li class="cb-row">' +
          (c.img ? '<img class="cb-thumb" src="' + esc(c.img) + '" alt="" loading="lazy">' : '<span class="cb-thumb"></span>') +
          '<div><p class="cb-name">' + esc(c.name) + '</p><p class="cb-meta">' + esc([c.game, c.code].filter(Boolean).join(' · ')) + '</p>' +
          '<div class="cb-offer"><span class="cb-cash">Cash <b>' + money(offer(c, 'NM', CASH)) + '</b></span><span class="cb-credit">Credit <b>' + money(offer(c, 'NM', CREDIT)) + '</b></span></div></div>' +
          '<div class="cb-actions"><label class="cb-vh" for="cond-' + c.id + '">Condition for ' + esc(c.name) + '</label><select id="cond-' + c.id + '" data-cond="' + c.id + '">' + opts + '</select>' +
          '<button type="button" class="cb-add" data-add="' + c.id + '" aria-label="Add ' + esc(c.name) + ' to sell list">Add</button></div></li>';
      });
      listEl.innerHTML = html;
      moreBtn.hidden = rows.length <= shown;
    }

    function byId(id) { return cards.filter(function (c) { return c.id === id; })[0]; }

    function renderCart() {
      sell = sell.filter(function (l) { return byId(l.id); });
      var count = 0, cash = 0, credit = 0, html = '', text = [];
      sell.forEach(function (l, i) {
        var c = byId(l.id); var oc = offer(c, l.cond, CASH), ocr = offer(c, l.cond, CREDIT);
        count += l.qty; cash += oc * l.qty; credit += ocr * l.qty;
        html += '<li class="cb-line"><div><div class="cb-line-name">' + esc(c.name) + '</div><div class="cb-line-sub">' + esc(c.code || c.game) + ' · ' + l.cond + ' · ' + money(oc) + ' / ' + money(ocr) + ' each</div></div>' +
          '<div class="cb-line-ctrl"><button type="button" class="cb-qbtn" data-dec="' + i + '" aria-label="One fewer ' + esc(c.name) + '">−</button><span aria-label="Quantity">' + l.qty + '</span>' +
          '<button type="button" class="cb-qbtn" data-inc="' + i + '" aria-label="One more ' + esc(c.name) + '">+</button></div></li>';
        text.push(l.qty + ' x ' + c.title + ' (' + c.game + ') - ' + l.cond + ' - cash ' + money(oc) + ' / credit ' + money(ocr) + ' each');
      });
      linesEl.innerHTML = html;
      emptyEl.hidden = sell.length > 0;
      cartCount.textContent = count + (count === 1 ? ' card' : ' cards');
      cashEl.textContent = money(cash); creditEl.textContent = money(credit);
      submitEl.disabled = sell.length === 0;
      bodyEl.value = 'BUYLIST QUOTE REQUEST\n' + text.join('\n') + '\n\nTotal cards: ' + count + '\nCash offer: ' + money(cash) + '\nStore credit offer: ' + money(credit) + '\n(Offers subject to inspection.)';
      mobilebar.hidden = count === 0;
      mobileSummary.textContent = count + (count === 1 ? ' card' : ' cards') + ' · ' + money(credit) + ' credit';
      save();
    }

    function buildFilters() {
      var games = SOURCES.map(function (s) { return s.label; });
      var gh = '<button type="button" class="cb-chip" data-game="" aria-pressed="true">All games</button>';
      games.forEach(function (g) { gh += '<button type="button" class="cb-chip" data-game="' + esc(g) + '" aria-pressed="false">' + esc(g) + '</button>'; });
      gamesEl.innerHTML = gh;
      var sets = {};
      cards.forEach(function (c) { if (c.set) sets[c.set] = true; });
      Object.keys(sets).sort().forEach(function (s) { var o = document.createElement('option'); o.value = s; o.textContent = s; setEl.appendChild(o); });
    }

    root.addEventListener('click', function (e) {
      var t = e.target.closest('button'); if (!t) return;
      if (t.hasAttribute('data-add')) {
        var id = t.getAttribute('data-add'); var cond = (root.querySelector('[data-cond="' + id + '"]') || {}).value || 'NM';
        var hit = sell.filter(function (l) { return l.id === id && l.cond === cond; })[0];
        if (hit) hit.qty = Math.min(MAXQ, hit.qty + 1); else sell.push({ id: id, cond: cond, qty: 1 });
        renderCart(); t.textContent = 'Added'; setTimeout(function () { t.textContent = 'Add'; }, 900);
      } else if (t.hasAttribute('data-inc')) {
        var a = sell[+t.getAttribute('data-inc')]; if (a) a.qty = Math.min(MAXQ, a.qty + 1); renderCart();
      } else if (t.hasAttribute('data-dec')) {
        var i = +t.getAttribute('data-dec'); var b = sell[i]; if (b) { b.qty -= 1; if (b.qty <= 0) sell.splice(i, 1); } renderCart();
      } else if (t.hasAttribute('data-game')) {
        game = t.getAttribute('data-game');
        gamesEl.querySelectorAll('[data-game]').forEach(function (x) { x.setAttribute('aria-pressed', x === t ? 'true' : 'false'); });
        shown = PAGE; renderList();
      } else if (t.hasAttribute('data-more')) { shown += PAGE; renderList(); }
    });
    var deb; qEl.addEventListener('input', function () { clearTimeout(deb); deb = setTimeout(function () { shown = PAGE; renderList(); }, 150); });
    setEl.addEventListener('change', function () { shown = PAGE; renderList(); });

    Promise.all(SOURCES.map(fetchAll)).then(function (all) {
      var seen = {};
      all.forEach(function (arr) { arr.forEach(function (c) { if (!seen[c.id]) { seen[c.id] = true; cards.push(c); } }); });
      buildFilters(); renderList(); renderCart();
    });
  })();
</script>

