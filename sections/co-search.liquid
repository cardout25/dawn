{%- comment -%} Card Out — wide search bar with live card suggestions {%- endcomment -%}
<style>
  #co-search-{{ section.id }} { background: {{ section.settings.bg }}; border-bottom: 1px solid #ECE8E1; font-family: 'Inter', var(--font-body-family); padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px; position: relative; z-index: 3; }
  #co-search-{{ section.id }} .cs-wrap { max-width: 72rem; margin: 0 auto; position: relative; }
  #co-search-{{ section.id }} .cs-form { position: relative; display: flex; align-items: center; margin: 0; }
  #co-search-{{ section.id }} .cs-icon { position: absolute; left: 2rem; width: 2rem; height: 2rem; color: #6B655C; pointer-events: none; }
  #co-search-{{ section.id }} .cs-input { width: 100%; height: 5.2rem; box-sizing: border-box; padding: 0 13rem 0 5.4rem; border: 1.5px solid #DDD8CF; border-radius: 999px; background: #FFFFFF; color: #1A1A1A; font: inherit; font-size: 1.6rem; box-shadow: 0 2px 6px rgba(0,0,0,.04); transition: border-color .15s ease, box-shadow .15s ease; -webkit-appearance: none; appearance: none; }
  #co-search-{{ section.id }} .cs-input::placeholder { color: #8C857A; }
  #co-search-{{ section.id }} .cs-input:focus { outline: none; border-color: #1A1A1A; box-shadow: 0 0 0 4px rgba(245,193,46,.45); }
  #co-search-{{ section.id }} .cs-input::-webkit-search-cancel-button { display: none; }
  #co-search-{{ section.id }} .cs-submit { position: absolute; right: .6rem; height: 4rem; padding: 0 2.2rem; border: 0; border-radius: 999px; background: #F25C54; color: #FFFFFF; font: inherit; font-weight: 600; font-size: 1.5rem; cursor: pointer; transition: background .15s ease; }
  #co-search-{{ section.id }} .cs-submit:hover { background: #D9443C; }
  #co-search-{{ section.id }} .cs-clear { position: absolute; right: 11.4rem; width: 3.2rem; height: 3.2rem; border: 0; border-radius: 50%; background: transparent; color: #6B655C; cursor: pointer; display: none; place-items: center; }
  #co-search-{{ section.id }} .cs-clear svg { width: 1.6rem; height: 1.6rem; }
  #co-search-{{ section.id }} .cs-clear.is-visible { display: grid; }
  #co-search-{{ section.id }} .cs-chips { display: flex; gap: .8rem; justify-content: center; flex-wrap: wrap; margin: 1.2rem 0 0; padding: 0; list-style: none; }
  #co-search-{{ section.id }} .cs-chips span { font-size: 1.3rem; color: #6B655C; align-self: center; }
  #co-search-{{ section.id }} .cs-chip { display: inline-flex; align-items: center; min-height: 3.2rem; padding: 0 1.4rem; border-radius: 999px; border: 1px solid #DDD8CF; background: #FFFFFF; color: #1A1A1A; text-decoration: none; font-size: 1.3rem; font-weight: 600; }
  #co-search-{{ section.id }} .cs-chip:hover { border-color: #1A1A1A; }
  #co-search-{{ section.id }} .cs-panel { position: absolute; top: calc(100% + .8rem); left: 0; right: 0; background: #FFFFFF; border: 1px solid #ECE8E1; border-radius: 1.8rem; box-shadow: 0 18px 44px rgba(0,0,0,.16); padding: .8rem; display: none; max-height: 60vh; overflow-y: auto; }
  #co-search-{{ section.id }} .cs-panel.is-open { display: block; }
  #co-search-{{ section.id }} .cs-label { margin: .8rem 1.2rem .4rem; font-size: 1.1rem; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; color: #6B655C; }
  #co-search-{{ section.id }} .cs-list { list-style: none; margin: 0; padding: 0; }
  #co-search-{{ section.id }} .cs-item { display: flex; align-items: center; gap: 1.4rem; padding: .8rem 1.2rem; border-radius: 1.2rem; text-decoration: none; color: #1A1A1A; }
  #co-search-{{ section.id }} .cs-item:hover, #co-search-{{ section.id }} .cs-item.is-active { background: #FAF8F4; }
  #co-search-{{ section.id }} .cs-thumb { flex: none; width: 4.4rem; aspect-ratio: 744 / 1039; border-radius: .6rem; background: #F4F1EC; object-fit: cover; }
  #co-search-{{ section.id }} .cs-text { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: .2rem; }
  #co-search-{{ section.id }} .cs-name { font-weight: 600; font-size: 1.5rem; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  #co-search-{{ section.id }} .cs-meta { font-size: 1.2rem; color: #6B655C; }
  #co-search-{{ section.id }} .cs-price { flex: none; font-weight: 700; font-size: 1.5rem; color: #B3352E; }
  #co-search-{{ section.id }} .cs-coll { display: inline-flex; margin: .2rem .4rem; padding: .6rem 1.2rem; border-radius: 999px; background: #FFF4D6; color: #1A1A1A; text-decoration: none; font-size: 1.3rem; font-weight: 600; }
  #co-search-{{ section.id }} .cs-colls { padding: 0 .8rem .4rem; }
  #co-search-{{ section.id }} .cs-all { display: block; margin: .6rem .4rem .2rem; padding: 1.2rem; border-radius: 1.2rem; text-align: center; font-weight: 600; font-size: 1.4rem; color: #1A1A1A; background: #FAF8F4; text-decoration: none; }
  #co-search-{{ section.id }} .cs-all:hover { background: #F1ECE3; }
  #co-search-{{ section.id }} .cs-empty { padding: 1.6rem 1.2rem; color: #6B655C; font-size: 1.4rem; margin: 0; }
  .cs-visually-hidden { position: absolute !important; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
  @media screen and (max-width: 749px) {
    #co-search-{{ section.id }} .cs-input { height: 4.8rem; padding-right: 5.6rem; font-size: 1.6rem; }
    #co-search-{{ section.id }} .cs-submit { width: 4rem; padding: 0; font-size: 0; }
    #co-search-{{ section.id }} .cs-submit::after { content: "→"; font-size: 1.8rem; }
    #co-search-{{ section.id }} .cs-clear { right: 5rem; }
    #co-search-{{ section.id }} .cs-chips { justify-content: flex-start; flex-wrap: nowrap; overflow-x: auto; }
    #co-search-{{ section.id }} .cs-chip { white-space: nowrap; }
  }
</style>

<div id="co-search-{{ section.id }}">
  <div class="page-width">
    <div class="cs-wrap">
      <form class="cs-form" action="{{ routes.search_url }}" method="get" role="search">
        <label class="cs-visually-hidden" for="cs-input-{{ section.id }}">Search the store</label>
        <svg class="cs-icon" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="7"/><path d="M20 20l-3.5-3.5"/></svg>
        <input class="cs-input" id="cs-input-{{ section.id }}" type="search" name="q" value="{{ search.terms | escape }}" placeholder="{{ section.settings.placeholder | escape }}" autocomplete="off" role="combobox" aria-autocomplete="list" aria-expanded="false" aria-controls="cs-panel-{{ section.id }}">
        <input type="hidden" name="options[prefix]" value="last">
        <button class="cs-clear" type="button" aria-label="Clear search"><svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"><path d="M6 6l12 12M18 6L6 18"/></svg></button>
        <button class="cs-submit" type="submit" aria-label="Search">Search</button>
      </form>
      <div class="cs-panel" id="cs-panel-{{ section.id }}" role="listbox" aria-label="Search suggestions"></div>
      <p class="cs-visually-hidden" aria-live="polite" data-status></p>
      {%- if section.blocks.size > 0 -%}
        <ul class="cs-chips">
          <li><span>Popular:</span></li>
          {%- for block in section.blocks -%}
            <li {{ block.shopify_attributes }}><a class="cs-chip" href="{{ block.settings.link | default: routes.all_products_collection_url }}">{{ block.settings.label }}</a></li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
    </div>
  </div>
</div>

<script>
  (function () {
    var root = document.getElementById('co-search-{{ section.id }}');
    if (!root) return;
    var input = root.querySelector('.cs-input');
    var panel = root.querySelector('.cs-panel');
    var clearBtn = root.querySelector('.cs-clear');
    var status = root.querySelector('[data-status]');
    var suggestUrl = '{{ routes.predictive_search_url }}.json';
    var searchUrl = '{{ routes.search_url }}';
    var timer = null, ctrl = null, active = -1;

    function esc(s) { return String(s == null ? '' : s).replace(/[&<>"']/g, function (c) { return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]; }); }
    function money(p) {
      var n = Number(p);
      if (!isFinite(n)) return '';
      if (String(p).indexOf('.') === -1 && n >= 100) n = n / 100;
      return '$' + n.toFixed(2) + ' SGD';
    }
    function img(p) {
      var u = p.featured_image && p.featured_image.url ? p.featured_image.url : p.image;
      if (!u) return '';
      return u + (u.indexOf('?') > -1 ? '&' : '?') + 'width=120';
    }
    function close() { panel.classList.remove('is-open'); input.setAttribute('aria-expanded', 'false'); active = -1; }
    function open() { panel.classList.add('is-open'); input.setAttribute('aria-expanded', 'true'); }
    function items() { return panel.querySelectorAll('.cs-item, .cs-coll, .cs-all'); }
    function setActive(i) {
      var list = items();
      if (!list.length) return;
      active = (i + list.length) % list.length;
      list.forEach(function (el, k) { el.classList.toggle('is-active', k === active); });
      list[active].scrollIntoView({ block: 'nearest' });
    }

    function render(q, data) {
      var res = (data && data.resources && data.resources.results) || {};
      var prods = res.products || [];
      var colls = res.collections || [];
      var html = '';
      if (colls.length) {
        html += '<p class="cs-label">Collections</p><div class="cs-colls">';
        colls.forEach(function (c) { html += '<a class="cs-coll" role="option" href="' + esc(c.url) + '">' + esc(c.title) + '</a>'; });
        html += '</div>';
      }
      if (prods.length) {
        html += '<p class="cs-label">Cards &amp; products</p><ul class="cs-list">';
        prods.forEach(function (p) {
          var t = String(p.title || '');
          var name = t.split(' [')[0];
          var code = t.indexOf('[') > -1 ? t.split('[').pop().replace(']', '') : (p.vendor || '');
          var src = img(p);
          html += '<li><a class="cs-item" role="option" href="' + esc(p.url) + '">' +
            (src ? '<img class="cs-thumb" src="' + esc(src) + '" alt="" loading="lazy">' : '<span class="cs-thumb"></span>') +
            '<span class="cs-text"><span class="cs-name">' + esc(name) + '</span><span class="cs-meta">' + esc(code) + '</span></span>' +
            '<span class="cs-price">' + esc(money(p.price)) + '</span></a></li>';
        });
        html += '</ul>';
      }
      if (!prods.length && !colls.length) {
        html = '<p class="cs-empty">No matches for “' + esc(q) + '”. Try a card name, set or game.</p>';
      }
      html += '<a class="cs-all" href="' + searchUrl + '?q=' + encodeURIComponent(q) + '&options%5Bprefix%5D=last">See all results for “' + esc(q) + '” →</a>';
      panel.innerHTML = html;
      status.textContent = prods.length + ' products and ' + colls.length + ' collections found';
      active = -1;
      open();
    }

    function lookup() {
      var q = input.value.trim();
      clearBtn.classList.toggle('is-visible', q.length > 0);
      if (q.length < 2) { close(); return; }
      if (ctrl) ctrl.abort();
      ctrl = window.AbortController ? new AbortController() : null;
      var url = suggestUrl + '?q=' + encodeURIComponent(q) +
        '&resources[type]=product,collection&resources[limit]=6&resources[options][unavailable_products]=last&resources[options][fields]=title,product_type,variants.title,vendor,tag';
      fetch(url, ctrl ? { signal: ctrl.signal } : {})
        .then(function (r) { return r.json(); })
        .then(function (d) { if (input.value.trim() === q) render(q, d); })
        .catch(function () {});
    }

    input.addEventListener('input', function () { clearTimeout(timer); timer = setTimeout(lookup, 180); });
    input.addEventListener('focus', function () { if (panel.innerHTML && input.value.trim().length >= 2) open(); });
    input.addEventListener('keydown', function (e) {
      if (e.key === 'ArrowDown') { e.preventDefault(); if (!panel.classList.contains('is-open')) lookup(); else setActive(active + 1); }
      else if (e.key === 'ArrowUp') { e.preventDefault(); setActive(active - 1); }
      else if (e.key === 'Escape') { close(); }
      else if (e.key === 'Enter' && active > -1) { var l = items(); if (l[active]) { e.preventDefault(); window.location.href = l[active].getAttribute('href'); } }
    });
    clearBtn.addEventListener('click', function () { input.value = ''; clearBtn.classList.remove('is-visible'); close(); input.focus(); });
    document.addEventListener('click', function (e) { if (!root.contains(e.target)) close(); });
    clearBtn.classList.toggle('is-visible', input.value.trim().length > 0);
  })();
</script>

{% schema %}
{
  "name": "Card Out search bar",
  "tag": "div",
  "class": "section",
  "max_blocks": 6,
  "settings": [
    { "type": "text", "id": "placeholder", "label": "Placeholder", "default": "Search cards, sets or products…" },
    { "type": "color", "id": "bg", "label": "Background", "default": "#FAF8F4" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 60, "step": 2, "unit": "px", "default": 18 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 60, "step": 2, "unit": "px", "default": 16 }
  ],
  "blocks": [
    {
      "type": "chip",
      "name": "Quick link",
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "default": "Origins" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [{ "name": "Card Out search bar" }]
}
{% endschema %}
