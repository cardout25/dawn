{%- comment -%} Card Out — homepage hero (polished) {%- endcomment -%}
{{ 'https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;700&family=Inter:wght@400;500;600;700&display=swap' | stylesheet_tag }}

<style>
  #co-hero-{{ section.id }} { background: {{ section.settings.bg }}; color: #1A1A1A; font-family: 'Inter', var(--font-body-family); }
  #co-hero-{{ section.id }} .co-hero__inner { padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px; text-align: center; }
  #co-hero-{{ section.id }} .co-hero__kicker { margin: 0 0 1.4rem; font-size: 1.3rem; font-weight: 700; letter-spacing: .16em; text-transform: uppercase; color: #5A4708; }
  #co-hero-{{ section.id }} h1 { margin: 0 auto 1.6rem; max-width: 76rem; font-family: 'Space Grotesk', var(--font-heading-family); font-weight: 700; font-size: clamp(3.6rem, 5vw, 5.6rem); line-height: 1.05; letter-spacing: -.02em; color: #1A1A1A; }
  #co-hero-{{ section.id }} .co-hero__text { margin: 0 auto 2.8rem; max-width: 56rem; font-size: 1.8rem; line-height: 1.6; color: #3B3214; }
  #co-hero-{{ section.id }} .co-hero__ctas { display: flex; gap: 1.2rem; justify-content: center; flex-wrap: wrap; }
  #co-hero-{{ section.id }} .co-btn { display: inline-flex; align-items: center; min-height: 5rem; padding: 0 2.8rem; border-radius: 999px; text-decoration: none; font-weight: 600; font-size: 1.6rem; transition: transform .15s ease, box-shadow .15s ease; }
  #co-hero-{{ section.id }} .co-btn:hover { transform: translateY(-1px); }
  #co-hero-{{ section.id }} .co-btn--primary { background: #F25C54; color: #FFFFFF; box-shadow: 0 8px 20px rgba(217,68,60,.25); }
  #co-hero-{{ section.id }} .co-btn--secondary { background: #FFFFFF; color: #1A1A1A; }
</style>

<section id="co-hero-{{ section.id }}">
  <div class="page-width co-hero__inner">
    {%- if section.settings.kicker != blank -%}<p class="co-hero__kicker">{{ section.settings.kicker }}</p>{%- endif -%}
    <h1>{{ section.settings.heading }}</h1>
    {%- if section.settings.text != blank -%}<p class="co-hero__text">{{ section.settings.text }}</p>{%- endif -%}
    <div class="co-hero__ctas">
      {%- if section.settings.button_label_1 != blank -%}
        <a class="co-btn co-btn--primary" href="{{ section.settings.button_link_1 | default: routes.all_products_collection_url }}">{{ section.settings.button_label_1 }}</a>
      {%- endif -%}
      {%- if section.settings.button_label_2 != blank -%}
        <a class="co-btn co-btn--secondary" href="{{ section.settings.button_link_2 | default: routes.root_url }}">{{ section.settings.button_label_2 }}</a>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Card Out hero",
  "tag": "div",
  "class": "section",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "Card Out · Singapore" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Your Riftbound card store in Singapore" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Singles from every set, sealed product and event entries. Order online, then self-collect or get it delivered across Singapore." },
    { "type": "text", "id": "button_label_1", "label": "Primary button label", "default": "Shop singles" },
    { "type": "url", "id": "button_link_1", "label": "Primary button link" },
    { "type": "text", "id": "button_label_2", "label": "Secondary button label", "default": "Event tickets" },
    { "type": "url", "id": "button_link_2", "label": "Secondary button link" },
    { "type": "color", "id": "bg", "label": "Background", "default": "#F5C12E" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 72 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 72 }
  ],
  "presets": [{ "name": "Card Out hero" }]
}
{% endschema %}
