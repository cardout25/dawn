{%- comment -%} Card Out — product grid with set filter chips {%- endcomment -%}
{%- liquid
  assign main = section.settings.collection
  assign items = main.products
  if section.settings.sort == 'price'
    assign items = items | sort: 'price' | reverse
  endif
-%}

<style>
  #co-grid-{{ section.id }} { background: #FFFFFF; color: #1A1A1A; font-family: 'Inter', var(--font-body-family); padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px; }
  #co-grid-{{ section.id }} .co-grid__head { display: flex; align-items: flex-end; justify-content: space-between; gap: 1.6rem; margin-bottom: 2.4rem; flex-wrap: wrap; }
  #co-grid-{{ section.id }} h2 { margin: 0 0 .6rem; font-family: 'Space Grotesk', var(--font-heading-family); font-weight: 700; font-size: 3.4rem; letter-spacing: -.01em; color: #1A1A1A; }
  #co-grid-{{ section.id }} .co-grid__sub { margin: 0; color: #6B655C; font-size: 1.5rem; }
  #co-grid-{{ section.id }} .co-grid__all { font-weight: 600; font-size: 1.5rem; color: #1A1A1A; text-decoration: underline; text-underline-offset: .3rem; }
  #co-grid-{{ section.id }} .co-chips { display: flex; gap: .8rem; margin: 0 0 2.4rem; padding: 0; list-style: none; flex-wrap: wrap; }
  #co-grid-{{ section.id }} .co-chip { display: inline-flex; align-items: center; min-height: 3.6rem; padding: 0 1.6rem; border-radius: 999px; border: 1px solid #DDD8CF; background: #FFFFFF; color: #1A1A1A; text-decoration: none; font-size: 1.4rem; font-weight: 600; transition: border-color .15s ease; }
  #co-grid-{{ section.id }} .co-chip:hover { border-color: #1A1A1A; }
  #co-grid-{{ section.id }} .co-chip--on { background: #1A1A1A; border-color: #1A1A1A; color: #FFFFFF; }
  #co-grid-{{ section.id }} .co-grid__list { display: grid; grid-template-columns: repeat({{ section.settings.columns }}, minmax(0, 1fr)); gap: 2.4rem; margin: 0; padding: 0; list-style: none; }
  #co-grid-{{ section.id }} .co-card { display: flex; flex-direction: column; gap: 1rem; text-decoration: none; color: #1A1A1A; }
  #co-grid-{{ section.id }} .co-card__art { position: relative; aspect-ratio: 744 / 1039; background: #F4F1EC; border-radius: 1.4rem; overflow: hidden; box-shadow: 0 1px 2px rgba(0,0,0,.06); transition: box-shadow .2s ease, transform .2s ease; }
  #co-grid-{{ section.id }} .co-card:hover .co-card__art { transform: translateY(-3px); box-shadow: 0 12px 28px rgba(0,0,0,.14); }
  #co-grid-{{ section.id }} .co-card__art img { width: 100%; height: 100%; object-fit: cover; display: block; }
  #co-grid-{{ section.id }} .co-card__badge { position: absolute; top: 1rem; left: 1rem; background: #FFFFFF; color: #B3352E; font-size: 1.2rem; font-weight: 700; padding: .4rem 1rem; border-radius: 999px; box-shadow: 0 1px 3px rgba(0,0,0,.12); }
  #co-grid-{{ section.id }} .co-card__badge--out { color: #6B655C; }
  #co-grid-{{ section.id }} .co-card__meta { font-size: 1.2rem; font-weight: 600; color: #6B655C; letter-spacing: .06em; }
  #co-grid-{{ section.id }} .co-card__name { font-weight: 600; font-size: 1.6rem; line-height: 1.3; }
  #co-grid-{{ section.id }} .co-card__price { font-weight: 700; font-size: 1.6rem; color: #B3352E; }
  #co-grid-{{ section.id }} .co-empty { color: #6B655C; font-size: 1.6rem; }
  @media screen and (max-width: 989px) { #co-grid-{{ section.id }} .co-grid__list { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  @media screen and (max-width: 749px) {
    #co-grid-{{ section.id }} .co-grid__list { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1.4rem; }
    #co-grid-{{ section.id }} h2 { font-size: 2.8rem; }
    #co-grid-{{ section.id }} .co-chips { flex-wrap: nowrap; overflow-x: auto; padding-bottom: .4rem; }
    #co-grid-{{ section.id }} .co-chip { white-space: nowrap; }
  }
</style>

<section id="co-grid-{{ section.id }}">
  <div class="page-width">
    <div class="co-grid__head">
      <div>
        <h2>{{ section.settings.heading }}</h2>
        {%- if section.settings.subheading != blank -%}<p class="co-grid__sub">{{ section.settings.subheading }}</p>{%- endif -%}
      </div>
      {%- if main != blank -%}<a class="co-grid__all" href="{{ main.url }}">View all {{ main.products_count }} →</a>{%- endif -%}
    </div>

    {%- if section.blocks.size > 0 -%}
      <ul class="co-chips">
        {%- if main != blank -%}<li><a class="co-chip co-chip--on" href="{{ main.url }}">{{ section.settings.all_label }}</a></li>{%- endif -%}
        {%- for block in section.blocks -%}
          {%- if block.settings.collection != blank -%}
            <li {{ block.shopify_attributes }}><a class="co-chip" href="{{ block.settings.collection.url }}">{{ block.settings.label | default: block.settings.collection.title }}</a></li>
          {%- endif -%}
        {%- endfor -%}
      </ul>
    {%- endif -%}

    {%- if main != blank and items.size > 0 -%}
      <ul class="co-grid__list">
        {%- for product in items limit: section.settings.limit -%}
          {%- liquid
            assign name = product.title | split: ' [' | first
            assign code = ''
            if product.title contains '['
              assign code = product.title | split: '[' | last | remove: ']' | split: '/' | first | replace: ' - ', ' '
            endif
            assign rarity = ''
            for t in product.tags
              if t == 'Epic' or t == 'Rare' or t == 'Legendary' or t == 'Showcase' or t == 'Uncommon' or t == 'Common'
                assign rarity = t
              endif
            endfor
            assign qty = product.selected_or_first_available_variant.inventory_quantity
          -%}
          <li>
            <a class="co-card" href="{{ product.url }}">
              <div class="co-card__art">
                {%- if product.featured_image -%}
                  {{ product.featured_image | image_url: width: 500 | image_tag: loading: 'lazy', alt: product.title, sizes: '(min-width: 990px) 25vw, 50vw' }}
                {%- else -%}
                  {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
                {%- endif -%}
                {%- unless product.available -%}
                  <span class="co-card__badge co-card__badge--out">Sold out</span>
                {%- else -%}
                  {%- if qty > 0 and qty <= section.settings.low_stock -%}<span class="co-card__badge">{% if qty == 1 %}Last one{% else %}Only {{ qty }} left{% endif %}</span>{%- endif -%}
                {%- endunless -%}
              </div>
              {%- if code != blank or rarity != blank -%}
                <span class="co-card__meta">{{ code }}{% if code != blank and rarity != blank %} · {% endif %}{{ rarity }}</span>
              {%- endif -%}
              <span class="co-card__name">{{ name }}</span>
              <span class="co-card__price">{{ product.price | money_with_currency }}</span>
            </a>
          </li>
        {%- endfor -%}
      </ul>
    {%- else -%}
      <p class="co-empty">Choose a collection for this section in the theme editor.</p>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Card Out card grid",
  "tag": "div",
  "class": "section",
  "max_blocks": 10,
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "New on the shelf" },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "Fresh Riftbound singles, Near Mint, English" },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "text", "id": "all_label", "label": "First chip label", "default": "All sets" },
    { "type": "select", "id": "sort", "label": "Order", "default": "collection", "options": [
      { "value": "collection", "label": "Collection order (newest)" },
      { "value": "price", "label": "Highest price first" }
    ] },
    { "type": "range", "id": "limit", "label": "Cards to show", "min": 4, "max": 24, "step": 1, "default": 8 },
    { "type": "range", "id": "columns", "label": "Columns on desktop", "min": 3, "max": 6, "step": 1, "default": 4 },
    { "type": "range", "id": "low_stock", "label": "Show 'Only X left' at or below", "min": 1, "max": 10, "step": 1, "default": 5 },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 64 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 48 }
  ],
  "blocks": [
    {
      "type": "chip",
      "name": "Set chip",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "text", "id": "label", "label": "Label (optional)" }
      ]
    }
  ],
  "presets": [{ "name": "Card Out card grid" }]
}
{% endschema %}
