{%- comment -%} Card Out — events call-out strip {%- endcomment -%}
<style>
  #co-events-{{ section.id }} { background: #FFFFFF; color: #1A1A1A; font-family: 'Inter', var(--font-body-family); padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px; }
  #co-events-{{ section.id }} .co-events__box { display: flex; align-items: center; justify-content: space-between; gap: 2.4rem; flex-wrap: wrap; padding: 3.6rem 4rem; border-radius: 2rem; border: 1px solid #ECE8E1; }
  #co-events-{{ section.id }} h2 { margin: 0 0 .8rem; font-family: 'Space Grotesk', var(--font-heading-family); font-weight: 700; font-size: 2.8rem; color: #1A1A1A; }
  #co-events-{{ section.id }} p { margin: 0; color: #6B655C; font-size: 1.6rem; line-height: 1.5; max-width: 60rem; }
  #co-events-{{ section.id }} .co-events__btn { display: inline-flex; align-items: center; min-height: 4.8rem; padding: 0 2.4rem; background: #1A1A1A; color: #FFFFFF; border-radius: 999px; text-decoration: none; font-weight: 600; font-size: 1.5rem; }
  #co-events-{{ section.id }} .co-events__btn:hover { background: #333333; }
  @media screen and (max-width: 749px) { #co-events-{{ section.id }} .co-events__box { padding: 2.8rem 2.2rem; } }
</style>

<section id="co-events-{{ section.id }}">
  <div class="page-width">
    <div class="co-events__box">
      <div>
        <h2>{{ section.settings.heading }}</h2>
        {%- if section.settings.text != blank -%}<p>{{ section.settings.text }}</p>{%- endif -%}
      </div>
      {%- if section.settings.button_label != blank -%}
        <a class="co-events__btn" href="{{ section.settings.button_link | default: routes.root_url }}">{{ section.settings.button_label }}</a>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Card Out events strip",
  "tag": "div",
  "class": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Play Riftbound at Card Out" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Weekly events in store. Some need a ticket to secure your slot." },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "See events" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 64 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 64 }
  ],
  "presets": [{ "name": "Card Out events strip" }]
}
{% endschema %}
