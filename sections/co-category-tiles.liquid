{%- comment -%} Card Out — colour category tiles {%- endcomment -%}
<style>
  #co-cats-{{ section.id }} { background: #FAF8F4; color: #1A1A1A; font-family: 'Inter', var(--font-body-family); padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px; }
  #co-cats-{{ section.id }} h2 { margin: 0 0 2.4rem; font-family: 'Space Grotesk', var(--font-heading-family); font-weight: 700; font-size: 3.4rem; letter-spacing: -.01em; color: #1A1A1A; }
  #co-cats-{{ section.id }} .co-cats__grid { display: grid; grid-template-columns: repeat({{ section.blocks.size | at_least: 1 | at_most: 4 }}, minmax(0, 1fr)); gap: 2.4rem; }
  #co-cats-{{ section.id }} .co-cat { display: flex; flex-direction: column; justify-content: space-between; min-height: 20rem; padding: 2.8rem; border-radius: 2rem; text-decoration: none; transition: transform .2s ease, box-shadow .2s ease; }
  #co-cats-{{ section.id }} .co-cat:hover { transform: translateY(-3px); box-shadow: 0 14px 30px rgba(0,0,0,.14); }
  #co-cats-{{ section.id }} .co-cat__kicker { font-size: 1.3rem; font-weight: 700; letter-spacing: .14em; text-transform: uppercase; opacity: .85; }
  #co-cats-{{ section.id }} .co-cat__title { display: block; font-family: 'Space Grotesk', var(--font-heading-family); font-weight: 700; font-size: 2.8rem; line-height: 1.15; margin-bottom: .6rem; }
  #co-cats-{{ section.id }} .co-cat__sub { font-size: 1.5rem; opacity: .9; }
  @media screen and (max-width: 749px) { #co-cats-{{ section.id }} .co-cats__grid { grid-template-columns: 1fr; gap: 1.4rem; } #co-cats-{{ section.id }} .co-cat { min-height: 15rem; } #co-cats-{{ section.id }} h2 { font-size: 2.8rem; } }
</style>

<section id="co-cats-{{ section.id }}">
  <div class="page-width">
    {%- if section.settings.heading != blank -%}<h2>{{ section.settings.heading }}</h2>{%- endif -%}
    <div class="co-cats__grid">
      {%- for block in section.blocks -%}
        {%- assign c = block.settings.collection -%}
        <a class="co-cat" href="{% if block.settings.link != blank %}{{ block.settings.link }}{% elsif c != blank %}{{ c.url }}{% else %}{{ routes.collections_url }}{% endif %}" style="background: {{ block.settings.bg }}; color: {{ block.settings.fg }};" {{ block.shopify_attributes }}>
          <span class="co-cat__kicker">{{ block.settings.kicker }}</span>
          <div>
            <span class="co-cat__title">{{ block.settings.title | default: c.title }}</span>
            <span class="co-cat__sub">{% if block.settings.show_count and c != blank %}{{ c.products_count }} {% if c.products_count == 1 %}item{% else %}items{% endif %}{% else %}{{ block.settings.sub }}{% endif %} →</span>
          </div>
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Card Out category tiles",
  "tag": "div",
  "class": "section",
  "max_blocks": 4,
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Shop by category" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 64 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 64 }
  ],
  "blocks": [
    {
      "type": "tile",
      "name": "Tile",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "url", "id": "link", "label": "Link (overrides collection)" },
        { "type": "text", "id": "kicker", "label": "Kicker", "default": "Category" },
        { "type": "text", "id": "title", "label": "Title (optional, uses collection name)" },
        { "type": "checkbox", "id": "show_count", "label": "Show item count", "default": false },
        { "type": "text", "id": "sub", "label": "Subtext (when count is off)", "default": "Shop now" },
        { "type": "color", "id": "bg", "label": "Background", "default": "#F25C54" },
        { "type": "color", "id": "fg", "label": "Text colour", "default": "#FFFFFF" }
      ]
    }
  ],
  "presets": [{ "name": "Card Out category tiles", "blocks": [{ "type": "tile" }, { "type": "tile" }, { "type": "tile" }] }]
}
{% endschema %}
